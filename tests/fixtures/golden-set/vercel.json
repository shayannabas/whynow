{
  "schemaVersion": 1,
  "seller": {
    "name": "Vercel",
    "domain": "vercel.com"
  },
  "entrySchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "domain", "expectedOutcome", "reason", "sourceUrls", "labeledBy"],
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "domain": {"type": "string", "minLength": 3},
      "expectedOutcome": {
        "anyOf": [
          {"const": "keep"},
          {"type": "string", "pattern": "^KILL_[A-Z][A-Z0-9_]*$"}
        ]
      },
      "reason": {"type": "string", "minLength": 1},
      "sourceUrls": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "format": "uri", "pattern": "^https://"}
      },
      "labeledBy": {"type": "string", "minLength": 1}
    }
  },
  "confirmed": [],
  "proposed": []
}
