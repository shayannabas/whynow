PORT=3000
HOST=127.0.0.1
# Durable state directory. Defaults to .whynow/ locally; set this to a mounted
# volume path in a future deployment.
STATE_DIR=.whynow
# A monitored address sent in the crawler's User-Agent header.
CRAWLER_CONTACT_EMAIL=
# Organization/product name used with the contact email for SEC EDGAR requests.
CRAWLER_NAME=WhyNow
# Optional search provider; never shown in the UI or stored in page caches.
SERPER_API_KEY=
# A key alone does not enable search. Keep this false until the owner authorizes use.
SERPER_ENABLED=false
# Conservative local-first limits for shared/trial credits.
WORKSPACE_MAX_SERPER_QUERIES_PER_RUN=4
# Collector refresh uses at most five bounded searches per account. This does
# not raise onboarding's four-query ceiling.
PHASE_B_MAX_SERPER_QUERIES_PER_ACCOUNT=5
# Refresh-all is separately fail-closed. Owner-authorized runs may set this up
# to the hard 150-query ceiling; normal local operation keeps it disabled.
REFRESH_ALL_MAX_SERPER_QUERIES_PER_RUN=0
# Discovery only runs after a manual action and has a hard per-workspace cap.
DISCOVERY_MAX_SERPER_QUERIES_PER_RUN=60
DISCOVERY_TARGET_COUNT=25
# Prepare demo shares one cap across discovery and Refresh all. OpenAI is never
# called by this workflow; model drafts remain a separate manual action.
PREPARE_DEMO_MAX_SERPER_QUERIES_PER_RUN=150
SERPER_MONTHLY_QUERY_LIMIT=50
ONBOARDING_MAX_PAGES=20
# SEC Form D uses free public EDGAR endpoints through the guarded runtime.
EDGAR_ENABLED=true
# Optional free news index. Respects robots and pauses at least 5.5 seconds.
# GDELT seendate is observation time, never proof of publication/event date.
GDELT_ENABLED=true
# Debug collection is unavailable in production.
NODE_ENV=development
# OpenAI research uses the configured model through the bounded HTTP client.
# Set your own key privately. A key alone never enables paid calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Focused seller research uses the configured GPT-5.5 model only when the owner
# separately enables OpenAI with a non-zero limit.
OPENAI_SELLER_FACTS_MODEL=gpt-5.5
OPENAI_ORGANIZATION_REVIEW_MODEL=gpt-5.5
OPENAI_ICP_TARGETING_MODEL=gpt-5.5
# Outreach has a separate model setting so changing it cannot alter Stage 2.
# No model-generated outreach call is authorized by this example setting.
OPENAI_OUTREACH_MODEL=gpt-5.5
OPENAI_ENABLED=false
# Default zero blocks paid calls; choose an approved limit before enabling.
OPENAI_MONTHLY_LIMIT_USD=0
OPENAI_WORKSPACE_MONTHLY_CALL_LIMIT=100
# Full structured drafts can take longer than a small chat response. The client
# remains bounded to 1–180 seconds and defaults to 90 seconds.
OPENAI_TIMEOUT_MS=90000

# Company-only lookalike discovery. No people or contact endpoints.
APOLLO_API_KEY=
APOLLO_ENABLED=false
APOLLO_COMPANY_SEARCH_ENABLED=false
# All ceilings must be explicitly positive before any request can run.
APOLLO_MAX_CALLS_PER_RUN=0
APOLLO_MONTHLY_CALL_LIMIT=0
APOLLO_MAX_CUSTOMERS_PER_RUN=3
APOLLO_MAX_COMPANIES_PER_RUN=10

# Company-scoped buyer persona search. Enable only for an approved, bounded run.
APOLLO_PEOPLE_ENABLED=false
APOLLO_PEOPLE_MONTHLY_CALL_LIMIT=0
