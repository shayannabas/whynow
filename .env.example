PORT=3000
HOST=127.0.0.1
# A monitored address sent in the crawler's User-Agent header.
CRAWLER_CONTACT_EMAIL=
# Optional search provider; never shown in the UI or stored in page caches.
SERPER_API_KEY=
# Debug collection is unavailable in production.
NODE_ENV=development
# OpenAI matches the friend's ICP parser model and direct HTTP setup.
# Set your own key privately. A key alone never enables paid calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false
# Default zero blocks paid calls; choose an approved limit before enabling.
OPENAI_MONTHLY_LIMIT_USD=0
OPENAI_WORKSPACE_MONTHLY_CALL_LIMIT=100
